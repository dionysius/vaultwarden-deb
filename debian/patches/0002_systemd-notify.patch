+// Tell systemd the server is ready (sd_notify protocol), if it asked for it
+#[cfg(target_os = "linux")]
+fn notify_systemd_ready() {
+    use std::os::{
+        linux::net::SocketAddrExt,
+        unix::net::{SocketAddr, UnixDatagram},
+    };
+
+    let Some(path) = std::env::var_os("NOTIFY_SOCKET") else {
+        return;
+    };
+    let addr = match path.as_encoded_bytes().strip_prefix(b"@") {
+        Some(name) => SocketAddr::from_abstract_name(name),
+        None => SocketAddr::from_pathname(&path),
+    };
+    if let Err(e) = addr.and_then(|addr| UnixDatagram::unbound()?.send_to_addr(b"READY=1", &addr)) {
+        warn!("Failed to notify systemd: {e}");
+    }
+}
+
+#[cfg(not(target_os = "linux"))]
+fn notify_systemd_ready() {}
