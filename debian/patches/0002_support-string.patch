+/// `PRETTY_NAME` of the OS currently running this process, read from `/etc/os-release`.
+pub fn os_release_pretty_name() -> String {
+    let Ok(contents) = std::fs::read_to_string("/etc/os-release") else {
+        return String::new();
+    };
+    contents
+        .lines()
+        .find_map(|line| line.strip_prefix("PRETTY_NAME="))
+        .map(|v| v.trim_matches('"').to_owned())
+        .unwrap_or_default()
+}
